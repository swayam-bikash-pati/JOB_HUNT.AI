# ============================================================
# JobHunter AI — Environment Variables
# ============================================================
# Copy this file to .env (for worker) and frontend/.env.local (for frontend).
# NEVER commit actual secrets to version control.
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND / CLIENT-SIDE (Browser Safe)
# ------------------------------------------------------------
# Required for the Next.js app (put in frontend/.env.local)
# Accepts either legacy anon key (eyJ...) or new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ------------------------------------------------------------
# 2. SERVER-SIDE & WORKER ONLY (Privileged Secret)
# ------------------------------------------------------------
# NEVER expose with NEXT_PUBLIC_ prefix or in client code!
# Used only by the Python worker and GitHub Actions runners.
# In GitHub repository: add as secret SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------
# 3. AI PROVIDER (Optional — ₹0 Free Tier / Local)
# ------------------------------------------------------------
# Options: "gemini", "ollama", or leave empty for offline mode
AI_PROVIDER=

# Google Gemini (Free Tier — only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Local Ollama (Free / Offline — only if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# 4. ₹0 COST GUARD & PIPELINE SETTINGS
# ------------------------------------------------------------
# Hard cap on daily AI calls to guarantee ₹0 cost
AI_DAILY_LIMIT=1000

# Minimum match score threshold to shortlist a job (0-100)
MINIMUM_MATCH_SCORE=70
