# ============================================================
# JobHunter AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Provider ---
# Options: "gemini", "ollama", or leave empty to disable AI features
AI_PROVIDER=

# Gemini (only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama (only if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- AI Cost Guard ---
# Maximum AI API calls per day (free tier protection)
AI_DAILY_LIMIT=1000

# --- Worker ---
# Minimum match score to shortlist (0-100)
MINIMUM_MATCH_SCORE=70

# --- Optional ---
# SMTP for email notifications (Phase 2)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
